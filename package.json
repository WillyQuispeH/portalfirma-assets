{
  "name": "portalfirma-asset",
  "productName": "PortalFirma Asset",
  "version": "0.16.28",
  "description": "PortalFirma Asset: gestión inmobiliaria 360 (cartera, personas, negocios y arriendos) con firma electrónica PortalFirma",
  "main": "src/main.js",
  "author": "Portalfirma",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac zip --x64 --arm64",
    "dist:mac-dmg": "electron-builder --mac dmg --x64 --arm64",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "cl.portalfirma.asset",
    "productName": "PortalFirma Asset",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!test/**"
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "identity": null,
      "extendInfo": {
        "NSHumanReadableCopyright": "© 2026 Portalfirma",
        "NSMicrophoneUsageDescription": "PortalFirma Asset usa el micrófono para que dictes los datos de una propiedad."
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Instalar PortalFirma Asset ${version}.${ext}",
      "publisherName": "Portalfirma",
      "legalTrademarks": "Portalfirma"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PortalFirma Asset",
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "PortalFirma Asset",
      "include": "build/installer.nsh",
      "license": "build/instalador/gen/licencia.txt",
      "installerSidebar": "build/instalador/gen/sidebar.bmp",
      "uninstallerSidebar": "build/instalador/gen/sidebar.bmp",
      "installerHeader": "build/instalador/gen/header.bmp",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "menuCategory": false,
      "artifactName": "Instalar PortalFirma Asset ${version}.${ext}"
    },
    "publish": null,
    "electronLanguages": [
      "es",
      "es_419",
      "en"
    ],
    "extraResources": [
      {
        "from": "build/ia",
        "to": "ia",
        "filter": [
          "*.bin"
        ]
      },
      {
        "from": "build/modelos",
        "to": "modelos",
        "filter": [
          "*.json"
        ]
      },
      {
        "from": "build/google",
        "to": "google",
        "filter": [
          "oauth.json"
        ]
      },
      {
        "from": "build/portalfirma",
        "to": "portalfirma",
        "filter": [
          "*.json"
        ]
      },
      {
        "from": "build/mercadolibre",
        "to": "mercadolibre",
        "filter": [
          "app.json"
        ]
      }
    ],
    "copyright": "© 2026 Portalfirma"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "docx": "^9.8.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/spa": "^1.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "playwright": "1.56",
    "tesseract.js": "^6.0.1"
  }
}
