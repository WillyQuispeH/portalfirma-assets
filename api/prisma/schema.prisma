// Base de datos de PortalFirma Asset (PostgreSQL, esquema `app`). Tablas y columnas en snake_case; modelos en español.
// Cambios: editar este archivo y correr `yarn db:migrar <nombre>` (crea la migración y la aplica en asset_dev).
//
// Criterios para todas las tablas de datos (escalabilidad):
//  · cada fila lleva corredora_id y los índices empiezan por él: cada consulta toca solo los datos de su corredora;
//  · actualizado_en indexado junto a corredora_id: la app de escritorio sincroniza solo lo que cambió (delta);
//  · eliminado_en (borrado lógico): la sincronización sabe qué quitar;
//  · version: control de concurrencia optimista (dos personas editando lo mismo no se pisan sin saberlo);
//  · id_legado: el id que tenía en el JSON local de la app (propiedades y personas); negocios y eventos conservan su id;
//  · búsqueda por parecido con pg_trgm (índice GIN) sobre un texto normalizado, rápida aunque haya muchos datos.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

/// La empresa (corredora de propiedades). Todo dato de la app pertenece a una corredora.
model Corredora {
  id               String               @id @default(uuid()) @db.Uuid
  nombre           String
  rut              String?              @unique
  /// siguiente número del código de propiedad (PF-1001, PF-1002…); se toma con UPDATE … RETURNING (atómico)
  siguienteCodigo  Int                  @default(1001) @map("siguiente_codigo")
  creadoEn         DateTime             @default(now()) @map("creado_en")
  actualizadoEn    DateTime             @updatedAt @map("actualizado_en")
  usuarios         Usuario[]
  propiedades      Propiedad[]
  personas         Persona[]
  actividad        Actividad[]
  negocios         Negocio[]
  eventos          Evento[]
  leads            Lead[]
  firmas           Firma[]
  registros        Registro[]
  contadores       Contador[]
  conexiones       Conexion[]
  conversaciones   AgenteConversacion[]
  registroAgente   AgenteRegistro[]
  casosReglas      ReglaCaso[]
  waProgramados    WaProgramado[]
  avisos           Aviso[]
  waAjustes        WaAjustes?
  waConversaciones WaConversacion[]
  waHilos          WaHilo[]
  waEnviados       WaEnviado[]
  waPuentes        WaPuente[]
  waVinculos       WaVinculo[]
  waEntrantes      WaEntrante[]
  iaConsumo        IaConsumo[]

  @@map("corredoras")
}

enum Rol {
  ADMIN
  CORREDOR

  @@map("rol")
}

/// Persona que inicia sesión en la app. El email es único en todo el sistema (se guarda en minúsculas).
/// Reemplaza a los «corredores» que la app guardaba en cada equipo: el captador de una propiedad es un usuario.
model Usuario {
  id             String               @id @default(uuid()) @db.Uuid
  corredoraId    String               @map("corredora_id") @db.Uuid
  email          String               @unique
  nombre         String
  hashClave      String               @map("hash_clave")
  rol            Rol                  @default(CORREDOR)
  activo         Boolean              @default(true)
  telefono       String?
  /// usuario de wechatia al que corresponde (para tomar el «propietario» de cada contacto allá)
  wechatiaId     String?              @map("wechatia_id")
  wechatiaNombre String?              @map("wechatia_nombre")
  ultimoIngreso  DateTime?            @map("ultimo_ingreso")
  creadoEn       DateTime             @default(now()) @map("creado_en")
  actualizadoEn  DateTime             @updatedAt @map("actualizado_en")
  corredora      Corredora            @relation(fields: [corredoraId], references: [id], onDelete: Restrict)
  sesiones       Sesion[]
  captaciones    Propiedad[]          @relation("captador")
  negocios       Negocio[]            @relation("negocioCorredor")
  eventos        Evento[]             @relation("eventoCorredor")
  leads          Lead[]               @relation("leadCorredor")
  firmasEnviadas Firma[]              @relation("firmaEnviadaPor")
  conexiones     Conexion[]           @relation("conexionUsuario")
  conversaciones AgenteConversacion[]
  registroAgente AgenteRegistro[]
  waVinculo      WaVinculo?
  waEntrantes    WaEntrante[]

  @@index([corredoraId])
  @@map("usuarios")
}

/// Una sesión abierta en un equipo. Guarda solo el hash del token de renovación; se rota en cada renovación.
model Sesion {
  id          String    @id @default(uuid()) @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  hashRenovar String    @map("hash_renovar")
  dispositivo String?
  ip          String?
  creadoEn    DateTime  @default(now()) @map("creado_en")
  usadoEn     DateTime  @default(now()) @map("usado_en")
  expiraEn    DateTime  @map("expira_en")
  revocadaEn  DateTime? @map("revocada_en")
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sesiones")
}

// ============================================================================ cartera

enum TipoPropiedad {
  casa
  departamento
  oficina
  sitio
  local_comercial
  industrial
  agricola
  parcela
  estacionamiento
  terreno_construccion
  bodega

  @@map("tipo_propiedad")
}

enum EstadoOperacion {
  disponible
  reservada
  vendida
  arrendada
  no_disponible

  @@map("estado_operacion")
}

enum Moneda {
  UF
  CLP
  USD

  @@map("moneda")
}

/// Una propiedad de la cartera. Lo que se filtra u ordena va en columnas con índice; la ficha extendida (~130 datos
/// de ficha-campos.js) va en `ficha` (JSONB): agregar un dato a la ficha no requiere migrar la tabla.
model Propiedad {
  id               String           @id @default(uuid()) @db.Uuid
  corredoraId      String           @map("corredora_id") @db.Uuid
  codigo           String
  titulo           String
  tipo             TipoPropiedad    @default(casa)
  venta            Boolean          @default(false)
  arriendo         Boolean          @default(false)
  precioVenta      Decimal?         @map("precio_venta") @db.Decimal(16, 2)
  monedaVenta      Moneda?          @map("moneda_venta")
  precioArriendo   Decimal?         @map("precio_arriendo") @db.Decimal(16, 2)
  monedaArriendo   Moneda?          @map("moneda_arriendo")
  estadoVenta      EstadoOperacion? @map("estado_venta")
  estadoArriendo   EstadoOperacion? @map("estado_arriendo")
  direccion        String?
  unidad           String?
  comuna           String?
  region           String?
  rol              String?
  lat              Float?
  lng              Float?
  placeId          String?          @map("place_id")
  supTotal         Decimal?         @map("sup_total") @db.Decimal(12, 2)
  supUtil          Decimal?         @map("sup_util") @db.Decimal(12, 2)
  dormitorios      Int?
  banos            Int?
  estacionamientos Int?
  bodegas          Int?
  amoblado         Boolean          @default(false)
  gastosComunes    Decimal?         @map("gastos_comunes") @db.Decimal(14, 2)
  descripcion      String?
  notasInternas    String?          @map("notas_internas")
  tituloPortal     String?          @map("titulo_portal")
  portalBarrio     String?          @map("portal_barrio")
  etiquetas        String[]         @default([])
  /// ficha completa (ficha-campos.js). Los datos del dueño (propietario*) se ocultan a quien no captó la propiedad
  ficha            Json             @default("{}")
  /// estado de la publicación en cada portal (publicaciones.js / mercadolibre.js); se normaliza con ese módulo
  portales         Json             @default("{}")
  /// interesados llegados desde los portales; se normaliza al pasar Leads a la base
  leadsPortal      Json             @default("[]") @map("leads_portal")
  captadorId       String?          @map("captador_id") @db.Uuid
  /// corredor que figura en el sistema de origen (p. ej. Portalfirma), solo informativo
  corredorOrigen   Json?            @map("corredor_origen")
  archivada        Boolean          @default(false)
  /// de dónde vino (portalfirma…) y su id allá: reimportar actualiza en vez de duplicar
  origenSistema    String?          @map("origen_sistema")
  origenId         String?          @map("origen_id")
  origenDatos      Json?            @map("origen_datos")
  /// campos editados en Asset: una nueva importación no los pisa
  editados         String[]         @default([])
  /// texto normalizado (sin tildes, minúsculas) de código, título, dirección, unidad y comuna, para buscar
  busqueda         String           @default("")
  idLegado         String?          @map("id_legado")
  version          Int              @default(1)
  creadoPorId      String?          @map("creado_por_id") @db.Uuid
  creadoEn         DateTime         @default(now()) @map("creado_en")
  actualizadoEn    DateTime         @updatedAt @map("actualizado_en")
  eliminadoEn      DateTime?        @map("eliminado_en")

  corredora  Corredora            @relation(fields: [corredoraId], references: [id], onDelete: Restrict)
  captador   Usuario?             @relation("captador", fields: [captadorId], references: [id], onDelete: SetNull)
  fotos      PropiedadFoto[]
  documentos PropiedadDocumento[]
  vinculos   PropiedadPersona[]
  negocios   Negocio[]
  eventos    Evento[]

  @@unique([corredoraId, codigo])
  @@unique([corredoraId, origenSistema, origenId])
  @@unique([corredoraId, idLegado])
  @@index([corredoraId, actualizadoEn])
  @@index([corredoraId, archivada, tipo])
  @@index([corredoraId, comuna])
  @@index([corredoraId, captadorId])
  @@index([corredoraId, venta, estadoVenta])
  @@index([corredoraId, arriendo, estadoArriendo])
  @@index([busqueda(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([ficha(ops: JsonbPathOps)], type: Gin)
  @@map("propiedades")
}

/// Fotos de una propiedad, en orden. `url`: https (portales o almacenamiento propio).
model PropiedadFoto {
  id          String    @id @default(uuid()) @db.Uuid
  propiedadId String    @map("propiedad_id") @db.Uuid
  url         String
  orden       Int       @default(0)
  destacada   Boolean   @default(false)
  creadoEn    DateTime  @default(now()) @map("creado_en")
  propiedad   Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  @@index([propiedadId, orden])
  @@map("propiedad_fotos")
}

/// Documentos de una propiedad (mandato, escritura, planos…): metadatos; el archivo va en el almacenamiento de objetos.
model PropiedadDocumento {
  id                  String    @id @default(uuid()) @db.Uuid
  propiedadId         String    @map("propiedad_id") @db.Uuid
  nombre              String
  tipo                String    @default("otro")
  tamano              Int?
  claveAlmacenamiento String?   @map("clave_almacenamiento")
  subidoPorId         String?   @map("subido_por_id") @db.Uuid
  creadoEn            DateTime  @default(now()) @map("creado_en")
  propiedad           Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  @@index([propiedadId])
  @@map("propiedad_documentos")
}

// ============================================================================ personas (CRM)

enum TipoPersona {
  natural
  juridica

  @@map("tipo_persona")
}

enum RolVinculo {
  propietario
  arrendatario
  comprador
  codeudor
  interesado
  proveedor

  @@map("rol_vinculo")
}

/// Personas y empresas de la corredora (propietarios, interesados, compradores…). El RUT es único por corredora,
/// pero puede faltar (un interesado que aún no lo da).
model Persona {
  id            String       @id @default(uuid()) @db.Uuid
  corredoraId   String       @map("corredora_id") @db.Uuid
  nombre        String
  /// RUT normalizado (sin puntos ni guion, DV en mayúscula): para buscar y para la unicidad
  rut           String?
  rutFormato    String?      @map("rut_formato")
  tipo          TipoPersona  @default(natural)
  email         String?
  telefono      String?
  direccion     String?
  estadoCivil   String?      @map("estado_civil")
  profesion     String?
  nacionalidad  String?      @default("chilena")
  roles         RolVinculo[] @default([])
  notas         String?
  /// datos sin columna propia (corredor asignado del lead, id del lead…)
  extra         Json         @default("{}")
  busqueda      String       @default("")
  idLegado      String?      @map("id_legado")
  version       Int          @default(1)
  creadoEn      DateTime     @default(now()) @map("creado_en")
  actualizadoEn DateTime     @updatedAt @map("actualizado_en")
  eliminadoEn   DateTime?    @map("eliminado_en")

  corredora Corredora          @relation(fields: [corredoraId], references: [id], onDelete: Restrict)
  vinculos  PropiedadPersona[]
  negocios  Negocio[]
  leads     Lead[]

  @@unique([corredoraId, rut])
  @@unique([corredoraId, idLegado])
  @@index([corredoraId, actualizadoEn])
  @@index([corredoraId, telefono])
  @@index([corredoraId, email])
  @@index([busqueda(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("personas")
}

/// Vínculo persona ↔ propiedad con su rol (una persona puede tener varios roles en la misma propiedad).
model PropiedadPersona {
  propiedadId String     @map("propiedad_id") @db.Uuid
  personaId   String     @map("persona_id") @db.Uuid
  rol         RolVinculo
  desde       DateTime   @default(now())
  propiedad   Propiedad  @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  persona     Persona    @relation(fields: [personaId], references: [id], onDelete: Restrict)

  @@id([propiedadId, personaId, rol])
  @@index([personaId])
  @@map("propiedad_personas")
}

// ============================================================================ actividad (historial)

/// Historial de lo que pasa (propiedades, personas, negocios, agenda…). Crece mucho: id secuencial (bigint) e índices
/// por entidad y por fecha. Si llega a millones de filas por corredora, se particiona por fecha.
model Actividad {
  id          BigInt    @id @default(autoincrement())
  corredoraId String    @map("corredora_id") @db.Uuid
  /// propiedad | persona | negocio | evento | otro
  entidadTipo String    @map("entidad_tipo")
  /// id de la entidad (texto: sirve también para lo que aún vive en el JSON local, como negocios y eventos)
  entidadId   String    @map("entidad_id")
  /// otra entidad relacionada (p. ej. la persona en «X vinculado como propietario»)
  ref2        String?
  /// nota | lead | null (automática)
  tipo        String?
  texto       String
  usuarioId   String?   @map("usuario_id") @db.Uuid
  fecha       DateTime  @default(now())
  corredora   Corredora @relation(fields: [corredoraId], references: [id], onDelete: Restrict)

  @@index([corredoraId, entidadId, fecha(sort: Desc)])
  @@index([corredoraId, ref2, fecha(sort: Desc)])
  @@index([corredoraId, fecha(sort: Desc)])
  @@map("actividad")
}

// ============================================================================ negocios y agenda
//
// La app de escritorio crea los ids (los mismos que ya tenían en su JSON local, o un UUID para los nuevos), así que
// son texto. Columnas solo para lo que se filtra o se relaciona; el resto de la estructura (tareas por etapa, firmas,
// comisión, próxima acción…) va en `datos`, tal como la usa la app. Cada uno está a cargo de un corredor (usuario):
// el corredor ve los suyos y el administrador, todos.

/// Un negocio de venta o arriendo y su avance por etapas (negocios.js de la app).
model Negocio {
  id            String    @id
  corredoraId   String    @map("corredora_id") @db.Uuid
  /// venta | arriendo
  tipo          String
  /// abierto | ganado | perdido
  estado        String    @default("abierto")
  etapa         String
  propiedadId   String?   @map("propiedad_id") @db.Uuid
  clienteId     String?   @map("cliente_id") @db.Uuid
  corredorId    String?   @map("corredor_id") @db.Uuid
  /// fecha de la próxima acción (para las vencidas)
  proximaFecha  DateTime? @map("proxima_fecha") @db.Date
  datos         Json      @default("{}")
  version       Int       @default(1)
  creadoPorId   String?   @map("creado_por_id") @db.Uuid
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")
  eliminadoEn   DateTime? @map("eliminado_en")

  corredora Corredora  @relation(fields: [corredoraId], references: [id], onDelete: Restrict)
  propiedad Propiedad? @relation(fields: [propiedadId], references: [id], onDelete: SetNull)
  cliente   Persona?   @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  corredor  Usuario?   @relation("negocioCorredor", fields: [corredorId], references: [id], onDelete: SetNull)

  @@index([corredoraId, actualizadoEn])
  @@index([corredoraId, corredorId, estado])
  @@index([corredoraId, propiedadId])
  @@index([corredoraId, clienteId])
  @@map("negocios")
}

/// Un evento de la agenda: visita, reunión, firma, llamada o tarea (agenda.js de la app).
model Evento {
  id            String    @id
  corredoraId   String    @map("corredora_id") @db.Uuid
  /// visita | reunion | firma | llamada | tarea | otro
  tipo          String
  /// programado | hecho | cancelado
  estado        String    @default("programado")
  fecha         DateTime  @db.Date
  /// HH:MM (hora de Chile), o null si es de todo el día
  hora          String?
  propiedadId   String?   @map("propiedad_id") @db.Uuid
  /// id del negocio (texto, sin llave foránea: puede llegar antes que el negocio)
  negocioId     String?   @map("negocio_id")
  personaIds    String[]  @default([]) @map("persona_ids")
  corredorId    String?   @map("corredor_id") @db.Uuid
  datos         Json      @default("{}")
  version       Int       @default(1)
  creadoPorId   String?   @map("creado_por_id") @db.Uuid
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")
  eliminadoEn   DateTime? @map("eliminado_en")

  corredora Corredora  @relation(fields: [corredoraId], references: [id], onDelete: Restrict)
  propiedad Propiedad? @relation(fields: [propiedadId], references: [id], onDelete: SetNull)
  corredor  Usuario?   @relation("eventoCorredor", fields: [corredorId], references: [id], onDelete: SetNull)

  @@index([corredoraId, actualizadoEn])
  @@index([corredoraId, corredorId, fecha])
  @@index([corredoraId, propiedadId])
  @@index([corredoraId, negocioId])
  @@index([personaIds], type: Gin)
  @@map("eventos")
}

// ============================================================================ leads

/// Un lead: la persona que escribió (WhatsApp, Instagram, correo, chat importado…) y lo que se sabe de ella (leads.js de
/// la app). Como negocios y eventos: id de la app, a cargo de un corredor, columnas para filtrar y el resto en `datos`.
/// Para no duplicar al mismo cliente cuando dos equipos lo reciben a la vez, un lead nuevo no puede repetir una
/// conversación (`convIds`) ni un teléfono (`telefonoNorm`, últimos 9 dígitos) de otro lead vivo.
model Lead {
  id            String    @id
  corredoraId   String    @map("corredora_id") @db.Uuid
  /// nuevo | contactado | visita | negociando | ganado | perdido
  estado        String    @default("nuevo")
  /// chat | whatsapp | instagram | facebook | email | portal | web | referido | otro
  origen        String    @default("otro")
  corredorId    String?   @map("corredor_id") @db.Uuid
  personaId     String?   @map("persona_id") @db.Uuid
  telefonoNorm  String?   @map("telefono_norm")
  email         String?
  /// conversaciones de wechatia (canales[].conv)
  convIds       String[]  @default([]) @map("conv_ids")
  /// fecha del último mensaje (hora local de la conversación, AAAA-MM-DDTHH:MM:SS)
  ultimoEn      String?   @map("ultimo_en")
  datos         Json      @default("{}")
  version       Int       @default(1)
  creadoPorId   String?   @map("creado_por_id") @db.Uuid
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")
  eliminadoEn   DateTime? @map("eliminado_en")

  corredora Corredora     @relation(fields: [corredoraId], references: [id], onDelete: Restrict)
  corredor  Usuario?      @relation("leadCorredor", fields: [corredorId], references: [id], onDelete: SetNull)
  persona   Persona?      @relation(fields: [personaId], references: [id], onDelete: SetNull)
  mensajes  LeadMensaje[]

  @@index([corredoraId, actualizadoEn])
  @@index([corredoraId, corredorId, estado])
  @@index([corredoraId, telefonoNorm])
  @@index([convIds], type: Gin)
  @@map("leads")
}

/// Un mensaje de la conversación de un lead. `k` es la clave que le da la app (hash del contenido, o «wc<id>» si vino
/// de wechatia): volver a mandarlo no lo duplica. Fotos y audios van a R2 (`mediaUrl`).
model LeadMensaje {
  id            BigInt   @id @default(autoincrement())
  leadId        String   @map("lead_id")
  corredoraId   String   @map("corredora_id") @db.Uuid
  k             String
  /// hora local de la conversación (AAAA-MM-DDTHH:MM:SS), como la escribe WhatsApp
  fecha         String
  /// cliente | broker | agente | corredor
  de            String?
  autor         String?
  texto         String   @default("")
  /// texto | imagen | audio | video | documento | contacto | omitido | sistema
  tipo          String   @default("texto")
  mediaUrl      String?  @map("media_url")
  /// el resto (archivo, transcripción, canal, asunto, «no entregado»…)
  datos         Json     @default("{}")
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, k])
  @@index([leadId, actualizadoEn])
  @@map("lead_mensajes")
}

// ============================================================================ firmas

/// Un documento enviado a firmar desde Asset (firmas.js de la app): la operación de Portalfirma, a qué propiedades y
/// negocio pertenece, quién lo envió, sus firmantes (con su calidad y si ya firmaron) y su estado. Reemplaza la lista
/// `firmas` que cada propiedad guardaba en el equipo que la envió y el historial local de «Mis operaciones».
/// Id: «op<número>» cuando hay operación (dos equipos que registran la misma operación escriben la misma fila).
/// Visible para toda la corredora; los firmantes que son dueños se reservan a quien no captó la propiedad.
model Firma {
  id            String    @id
  corredoraId   String    @map("corredora_id") @db.Uuid
  operacion     Int?
  /// nombre del documento (plantilla, formato o archivo)
  documento     String
  /// plantilla | asset | formato | agente | editor | masiva…
  origen        String    @default("asset")
  /// en_firma | firmado | anulado | rechazado | pendiente_pago
  estado        String    @default("en_firma")
  legalizado    Boolean   @default(false)
  firmados      Int       @default(0)
  total         Int       @default(0)
  propiedadIds  String[]  @default([]) @map("propiedad_ids")
  negocioId     String?   @map("negocio_id")
  enviadoPorId  String?   @map("enviado_por_id") @db.Uuid
  enviadoEn     DateTime  @default(now()) @map("enviado_en")
  firmadoEn     DateTime? @map("firmado_en")
  /// última vez que alguien consultó la operación en Portalfirma
  revisadoEn    DateTime? @map("revisado_en")
  /// [{ nombre, rut, rol, personaId, email, telefono, firmo }]
  firmantes     Json      @default("[]")
  /// el resto (plantillaId, formato, hito, número, archivo, tipo de firma, trámite…)
  datos         Json      @default("{}")
  version       Int       @default(1)
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")
  eliminadoEn   DateTime? @map("eliminado_en")

  corredora  Corredora @relation(fields: [corredoraId], references: [id], onDelete: Restrict)
  enviadoPor Usuario?  @relation("firmaEnviadaPor", fields: [enviadoPorId], references: [id], onDelete: SetNull)

  @@unique([corredoraId, operacion])
  @@index([corredoraId, actualizadoEn])
  @@index([corredoraId, estado])
  @@index([corredoraId, negocioId])
  @@index([propiedadIds], type: Gin)
  @@map("firmas")
}

// ============================================================================ registros (colecciones de la app)

/// Datos de la app que viven como documentos dentro de una colección: postventa (proyectos, unidades, reclamos,
/// contratistas, conversaciones, configuración del asistente), plazos, expedientes, configuración de la corredora…
/// La lógica de cada uno está en la app; aquí se guardan con su versión y la sincronización por cambios, como los
/// negocios. Las colecciones permitidas y quién las ve están en src/registros/registros.ts. El id lo pone la app.
model Registro {
  corredoraId   String    @map("corredora_id") @db.Uuid
  coleccion     String
  id            String
  /// dueño, en las colecciones de cada usuario (plazos, expedientes); null en las de toda la corredora
  usuarioId     String?   @map("usuario_id") @db.Uuid
  datos         Json      @default("{}")
  version       Int       @default(1)
  creadoPorId   String?   @map("creado_por_id") @db.Uuid
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")
  eliminadoEn   DateTime? @map("eliminado_en")

  corredora Corredora @relation(fields: [corredoraId], references: [id], onDelete: Restrict)

  @@id([corredoraId, coleccion, id])
  @@index([corredoraId, coleccion, actualizadoEn])
  @@index([corredoraId, coleccion, usuarioId, actualizadoEn])
  @@map("registros")
}

/// Números correlativos por corredora (p. ej. el folio PV-0001 de los reclamos de postventa): se toman con
/// INSERT … ON CONFLICT … RETURNING, así dos equipos no reciben el mismo número.
model Contador {
  corredoraId String    @map("corredora_id") @db.Uuid
  serie       String
  valor       Int       @default(0)
  corredora   Corredora @relation(fields: [corredoraId], references: [id], onDelete: Restrict)

  @@id([corredoraId, serie])
  @@map("contadores")
}

// ============================================================================ conexiones (integraciones)

/// Una sesión con un servicio externo: OAuth (Portalfirma, Portal Inmobiliario/Mercado Libre, Google Drive…) o una
/// clave de API (wechatia, Google Maps). Vive SOLO en el servidor: la app de escritorio nunca ve los tokens, pide a la
/// API que llame al servicio. Una por proveedor y dueño: de un usuario (usuario_id) o de toda la corredora (null).
/// Los secretos van cifrados (AES-256-GCM, llave CONEXIONES_CLAVE del .env; ver src/conexiones/cifrado.ts).
model Conexion {
  id            String    @id @default(uuid()) @db.Uuid
  corredoraId   String    @map("corredora_id") @db.Uuid
  /// dueño de la sesión; null = de toda la corredora
  usuarioId     String?   @map("usuario_id") @db.Uuid
  /// el id del usuario o «corredora»: para que haya una sola sesión por proveedor y dueño
  dueno         String
  /// portalfirma | mercadolibre | google_drive | wechatia | google_maps… (lista en src/conexiones/proveedores.ts)
  proveedor     String
  /// oauth | clave
  tipo          String    @default("oauth")
  /// activa | vencida (hay que volver a conectar) | revocada | error
  estado        String    @default("activa")
  /// cuenta al otro lado: id y nombre o correo («conectado como …»)
  cuentaId      String?   @map("cuenta_id")
  cuentaNombre  String?   @map("cuenta_nombre")
  alcance       String?
  /// cifrados: token de acceso y de renovación (o la clave, en tipo «clave»)
  accesoCif     String?   @map("acceso_cif")
  renovarCif    String?   @map("renovar_cif")
  expiraEn      DateTime? @map("expira_en")
  /// datos no secretos del proveedor (p. ej. locationId de wechatia)
  datos         Json      @default("{}")
  ultimoError   String?   @map("ultimo_error")
  conectadoPor  String?   @map("conectado_por") @db.Uuid
  conectadoEn   DateTime  @default(now()) @map("conectado_en")
  renovadoEn    DateTime? @map("renovado_en")
  usadoEn       DateTime? @map("usado_en")
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")

  corredora Corredora @relation(fields: [corredoraId], references: [id], onDelete: Restrict)
  usuario   Usuario?  @relation("conexionUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([corredoraId, proveedor, dueno])
  @@index([proveedor, estado, expiraEn])
  @@map("conexiones")
}

/// Una autorización OAuth en curso: el usuario está en la página del proveedor. Se busca por `state` cuando el
/// proveedor vuelve al callback; dura 10 minutos y se usa una sola vez.
model OauthPendiente {
  state          String   @id
  corredoraId    String   @map("corredora_id") @db.Uuid
  usuarioId      String   @map("usuario_id") @db.Uuid
  proveedor      String
  /// para quién queda la sesión: el usuario o toda la corredora
  deCorredora    Boolean  @default(false) @map("de_corredora")
  verificadorCif String   @map("verificador_cif")
  creadoEn       DateTime @default(now()) @map("creado_en")
  expiraEn       DateTime @map("expira_en")

  @@index([expiraEn])
  @@map("oauth_pendientes")
}

/// El registro de Asset como aplicación en cada proveedor OAuth que lo crea solo (registro dinámico, p. ej.
/// Portalfirma). Uno por proveedor y dirección de retorno. Google y Mercado Libre vienen del .env.
model OauthCliente {
  proveedor   String
  redirectUri String   @map("redirect_uri")
  /// información del cliente (client_id; client_secret cifrado si lo hay)
  clienteCif  String   @map("cliente_cif")
  creadoEn    DateTime @default(now()) @map("creado_en")

  @@id([proveedor, redirectUri])
  @@map("oauth_clientes")
}

// ============================================================================ agente

/// Una conversación con el Agente (chat de la app o el hilo «WhatsApp»). Es de su usuario: solo él la escribe; el
/// administrador de la corredora puede leerla. El id lo pone la app (k…). `datos` lleva lo que se ve en el chat
/// (items), lo que necesita el modelo para seguir (messages), el contexto del lienzo (ctx) y el resumen.
model AgenteConversacion {
  usuarioId     String    @map("usuario_id") @db.Uuid
  id            String
  corredoraId   String    @map("corredora_id") @db.Uuid
  titulo        String    @default("")
  fijada        Boolean   @default(false)
  datos         Json      @default("{}")
  version       Int       @default(1)
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")
  eliminadoEn   DateTime? @map("eliminado_en")

  corredora Corredora @relation(fields: [corredoraId], references: [id], onDelete: Restrict)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, id])
  @@index([usuarioId, actualizadoEn])
  @@index([corredoraId, actualizadoEn])
  @@map("agente_conversaciones")
}

/// Lo que hizo el Agente (cada herramienta que cambió algo, o que el usuario canceló): para saber qué hizo y por
/// orden de quién. Solo se agrega; lo ve su usuario y el administrador de la corredora.
model AgenteRegistro {
  id          BigInt   @id @default(autoincrement())
  corredoraId String   @map("corredora_id") @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  fecha       DateTime @default(now())
  /// app | whatsapp
  canal       String   @default("app")
  herramienta String
  accion      String?
  ok          Boolean  @default(true)
  resumen     String   @default("")

  corredora Corredora @relation(fields: [corredoraId], references: [id], onDelete: Restrict)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, fecha])
  @@index([corredoraId, fecha])
  @@map("agente_registro")
}

// ============================================================================ plataforma (compartido por todas las corredoras)

/// Un caso de aprendizaje de reglas notariales: un documento donde el cliente corrigió la detección (materia o actos).
/// La app tacha los datos personales antes de mandarlo. Cada corredora ve y borra solo los suyos; el revisor de la
/// plataforma (PLATAFORMA_REVISORES) los ve todos, sin saber de qué corredora vienen. Uno por documento (clave).
model ReglaCaso {
  id          String   @id
  corredoraId String   @map("corredora_id") @db.Uuid
  usuarioId   String?  @map("usuario_id") @db.Uuid
  /// huella del documento: si se corrige de nuevo el mismo, se reemplaza
  clave       String
  datos       Json     @default("{}")
  creadoEn    DateTime @default(now()) @map("creado_en")

  corredora Corredora @relation(fields: [corredoraId], references: [id], onDelete: Cascade)

  @@unique([corredoraId, clave])
  @@index([creadoEn])
  @@map("reglas_casos")
}

/// Documentos de la plataforma, uno por clave (p. ej. «reglas_notariales»: las reglas aprobadas y las propuestas).
/// Todas las corredoras los leen; los cambia el revisor de la plataforma, con `version` para no pisarse.
model PlataformaDocumento {
  clave          String   @id
  datos          Json     @default("{}")
  version        Int      @default(1)
  actualizadoPor String?  @map("actualizado_por") @db.Uuid
  actualizadoEn  DateTime @updatedAt @map("actualizado_en")

  @@map("plataforma_documentos")
}

/// WhatsApp programados: los envía el servidor a su hora (con la clave de wechatia de la corredora), aunque la app
/// esté cerrada. Los crea el usuario (por el Agente) y solo él los ve. `estado`: programado → enviando → enviado |
/// no_entregado | fallido; o cancelado. Se toman con FOR UPDATE SKIP LOCKED: nunca salen dos veces.
/// `avisadoEn`: la app del usuario ya hizo lo suyo con el resultado (avisarle y anotarlo en el lead).
model WaProgramado {
  corredoraId   String    @map("corredora_id") @db.Uuid
  id            String
  usuarioId     String    @map("usuario_id") @db.Uuid
  telefono      String
  nombre        String    @default("")
  personaId     String?   @map("persona_id")
  texto         String
  cuando        DateTime
  estado        String    @default("programado")
  /// la plantilla aprobada por Meta que se usa si la persona no ha escrito en 24 h: { id, nombre, etiqueta, campos }
  plantilla     Json?
  /// messageId, contactId, plantilla usada, error, entrega
  resultado     Json      @default("{}")
  enviadoEn     DateTime? @map("enviado_en")
  /// hasta cuándo se revisa si WhatsApp lo entregó (Meta puede rechazarlo minutos después)
  revisarHasta  DateTime? @map("revisar_hasta")
  avisadoEn     DateTime? @map("avisado_en")
  version       Int       @default(1)
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")

  corredora Corredora @relation(fields: [corredoraId], references: [id], onDelete: Cascade)

  @@id([corredoraId, id])
  @@index([estado, cuando])
  @@index([revisarHasta])
  @@index([usuarioId, actualizadoEn])
  @@map("wa_programados")
}

/// Avisos del servidor a un usuario (p. ej. «X firmó la promesa» de la revisión de firmas). La app los trae y los toma
/// una sola vez (`tomadoEn`), aunque el usuario tenga dos equipos abiertos; si estaba cerrada, los ve al abrirla.
/// `tipo` dice qué hace la app además de mostrarlo (firmas, firma_negocio…); `datos`, con qué.
model Aviso {
  id          BigInt    @id @default(autoincrement())
  corredoraId String    @map("corredora_id") @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  tipo        String
  texto       String
  datos       Json      @default("{}")
  creadoEn    DateTime  @default(now()) @map("creado_en")
  tomadoEn    DateTime? @map("tomado_en")

  corredora Corredora @relation(fields: [corredoraId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tomadoEn])
  @@index([creadoEn])
  @@map("avisos")
}

// ============================================================================ asistentes de WhatsApp (en el servidor)
//
// El servidor lee el WhatsApp de la empresa (wechatia) por cada corredora y reparte cada conversación a UN asistente:
// el celular de un ejecutivo (su Asset), Sofía (leads), Tomás (clientes del CRM), postventa (reclamos) o el observador
// (Instagram, Facebook y correo → Leads). Antes cada equipo leía por su cuenta y dos equipos podían responder dos veces.

/// Ajustes de los asistentes de una corredora y el turno del lector: un solo lector a la vez por corredora
/// (`lectorHasta` se toma con UPDATE … WHERE lector_hasta < now(), aunque corran dos API).
model WaAjustes {
  corredoraId    String    @id @map("corredora_id") @db.Uuid
  /// Tomás atiende a las personas del CRM
  clientesActivo Boolean   @default(true) @map("clientes_activo")
  /// Sofía atiende a los leads (apagada: sus mensajes solo se anotan en el lead y se avisa al corredor a cargo)
  leadsActivo    Boolean   @default(true) @map("leads_activo")
  /// { activo, canales: { instagram, facebook, email }, ia, diasInicio, autorizadoPor, autorizadoEn }
  observador     Json      @default("{}")
  lectorHasta    DateTime? @map("lector_hasta")
  /// última ronda terminada y su error (si lo hubo)
  lectorEn       DateTime? @map("lector_en")
  lectorError    String?   @map("lector_error")
  /// hasta cuándo leer seguido (alguien está conversando con un asistente)
  rapidoHasta    DateTime? @map("rapido_hasta")
  /// última vez que el observador revisó Instagram, Facebook y correo, y su resultado
  observadorEn   DateTime? @map("observador_en")
  observadorRes  Json      @default("{}") @map("observador_res")
  actualizadoEn  DateTime  @updatedAt @map("actualizado_en")

  corredora Corredora @relation(fields: [corredoraId], references: [id], onDelete: Cascade)

  @@map("wa_ajustes")
}

/// Hasta dónde se leyó cada conversación de wechatia (canal, último mensaje visto) y, para el observador, a qué lead va.
model WaConversacion {
  corredoraId   String   @map("corredora_id") @db.Uuid
  convId        String   @map("conv_id")
  /// whatsapp | instagram | facebook | email
  canal         String   @default("whatsapp")
  telefonoNorm  String?  @map("telefono_norm")
  contactId     String?  @map("contact_id")
  /// lastMessageDate de wechatia en la última lectura: si no cambió, no se vuelve a leer
  marca         String?
  ultimoMsgId   String?  @map("ultimo_msg_id")
  /// conversación nueva: se miran los mensajes desde aquí
  desde         DateTime @default(now())
  leadId        String?  @map("lead_id")
  /// «propietario» del contacto en wechatia (usuario de wechatia) visto la última vez
  dueno         String?
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  corredora Corredora @relation(fields: [corredoraId], references: [id], onDelete: Cascade)

  @@id([corredoraId, convId])
  @@index([corredoraId, telefonoNorm])
  @@map("wa_conversaciones")
}

/// La conversación de Sofía o Tomás con un número: lo último conversado (para la IA), la pausa cuando el corredor
/// escribe a mano y las marcas de tiempo.
model WaHilo {
  corredoraId   String    @map("corredora_id") @db.Uuid
  telefonoNorm  String    @map("telefono_norm")
  /// [{ role: user|assistant, content }] (las últimas 20)
  mensajes      Json      @default("[]")
  pausaHasta    DateTime? @map("pausa_hasta")
  /// hasta dónde se revisaron los mensajes escritos a mano por el corredor
  visto         DateTime?
  /// última respuesta del asistente
  ultimo        DateTime?
  /// último envío de Asset a este número (una conversación nueva se lee desde ahí)
  ultEnvio      DateTime? @map("ult_envio")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")

  corredora Corredora @relation(fields: [corredoraId], references: [id], onDelete: Cascade)

  @@id([corredoraId, telefonoNorm])
  @@map("wa_hilos")
}

/// Lo que mandó Asset por WhatsApp (asistentes, programados, la app): así un mensaje saliente que no está aquí se
/// reconoce como escrito a mano por el corredor. Se borran a los 30 días.
model WaEnviado {
  id           BigInt   @id @default(autoincrement())
  corredoraId  String   @map("corredora_id") @db.Uuid
  telefonoNorm String   @map("telefono_norm")
  messageId    String?  @map("message_id")
  /// texto normalizado (120 caracteres)
  huella       String   @default("")
  plantilla    Boolean  @default(false)
  creadoEn     DateTime @default(now()) @map("creado_en")

  corredora Corredora @relation(fields: [corredoraId], references: [id], onDelete: Cascade)

  @@index([corredoraId, telefonoNorm, creadoEn])
  @@index([messageId])
  @@index([creadoEn])
  @@map("wa_enviados")
}

/// El celular de un ejecutivo ligado a su cuenta (Agente por WhatsApp). Se vincula enviando el código («ASSET 4821»)
/// al número de la empresa. `senalEn`: la última vez que su Asset abierto pidió los mensajes (si pasa más de un minuto,
/// su Asset está cerrado y el servidor se lo dice una vez).
model WaVinculo {
  usuarioId      String    @id @map("usuario_id") @db.Uuid
  corredoraId    String    @map("corredora_id") @db.Uuid
  telefono       String?
  telefonoNorm   String?   @map("telefono_norm")
  contactId      String?   @map("contact_id")
  codigo         String?
  activo         Boolean   @default(false)
  /// { nombre, email, apodo, numeroEmpresa }
  datos          Json      @default("{}")
  vinculadoEn    DateTime? @map("vinculado_en")
  senalEn        DateTime? @map("senal_en")
  avisoCerradoEn DateTime? @map("aviso_cerrado_en")
  actualizadoEn  DateTime  @updatedAt @map("actualizado_en")

  corredora Corredora @relation(fields: [corredoraId], references: [id], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([corredoraId, telefonoNorm])
  @@unique([corredoraId, codigo])
  @@map("wa_vinculos")
}

/// Mensajes del celular del ejecutivo para su Asset: la app los toma (una sola vez) y los atiende con el Agente.
model WaEntrante {
  id          BigInt    @id @default(autoincrement())
  corredoraId String    @map("corredora_id") @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  /// { id, body, attachments, dateAdded }
  mensaje     Json
  creadoEn    DateTime  @default(now()) @map("creado_en")
  tomadoEn    DateTime? @map("tomado_en")

  corredora Corredora @relation(fields: [corredoraId], references: [id], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tomadoEn])
  @@index([creadoEn])
  @@map("wa_entrantes")
}

/// Uso de IA del servidor por corredora (para cobrarlo después): para qué, modelo y tokens.
model IaConsumo {
  id          BigInt   @id @default(autoincrement())
  corredoraId String   @map("corredora_id") @db.Uuid
  uso         String
  modelo      String
  entrada     Int      @default(0)
  salida      Int      @default(0)
  creadoEn    DateTime @default(now()) @map("creado_en")

  corredora Corredora @relation(fields: [corredoraId], references: [id], onDelete: Cascade)

  @@index([corredoraId, creadoEn])
  @@map("ia_consumo")
}

/// Puente corredor ↔ interesado: el mensaje del interesado que se reenvió al celular del corredor (message_id) y a qué
/// lead corresponde; si el corredor responde citándolo, la respuesta va a ese lead. Se borran a los 30 días.
model WaPuente {
  id          BigInt   @id @default(autoincrement())
  corredoraId String   @map("corredora_id") @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  leadId      String   @map("lead_id")
  messageId   String   @map("message_id")
  creadoEn    DateTime @default(now()) @map("creado_en")

  corredora Corredora @relation(fields: [corredoraId], references: [id], onDelete: Cascade)

  @@index([corredoraId, messageId])
  @@index([creadoEn])
  @@map("wa_puente")
}
